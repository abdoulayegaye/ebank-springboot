# ── Docker Hub ───────────────────────────────────────────────
DOCKER_HUB_USERNAME=layegaye
APP_VERSION=1.0.0

# ── MySQL ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ebank_db
